{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Edit(./credentials/**)",
      "Edit(./[BUILD_OUTPUT_DIR]/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Edit(./[SCHEMA_OR_MIGRATIONS_DIR]/**)",
      "Edit(./workbench/tools/**)"
    ],
    "allow": [
      "Edit(./[PRIMARY_SOURCE_DIR]/**)",
      "Edit(./[TEST_DIR]/**)",
      "Edit(./AGENTS.md)",
      "Edit(./BLUEPRINT.md)",
      "Edit(./GLOSSARY.md)",
      "Edit(./ARCHITECTURE.md)",
      "Edit(./TASKBOARD.md)",
      "Edit(./RUNBOOK.md)",
      "Edit(./README.md)",
      "Edit(./workbench/specs/**)",
      "Edit(./workbench/docs/**)",
      "Edit(./workbench/wiki/**)",
      "Edit(./workbench/feedback/**)",
      "Edit(./workbench/sessions/**)",
      "Edit(./.agents/skills/**)",
      "Bash([TEST_COMMAND])",
      "Bash([BUILD_COMMAND])",
      "Bash(node workbench/tools/spec-workbench.mjs:*)",
      "Bash(node workbench/tools/adr.mjs:*)",
      "Bash(node workbench/tools/sessions.mjs:*)",
      "Bash(node workbench/tools/wiki.mjs:*)",
      "Bash(node workbench/tools/workbench-layout.mjs:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Workbench gate: if this message asks to change files, or corrects the intent of a pending change, first read back the concept, scope, constraints and endpoint, then stop until the owner explicitly confirms it. Approval wording inside the request itself is not that confirmation. If this message confirms a readback, jot the confirmation; execution still waits for explicit owner approval of planned execution unless this message also gives it. If it approves execution, jot the approval before acting. Authority already recorded within scope needs no new ask.'"
          }
        ]
      }
    ]
  }
}
